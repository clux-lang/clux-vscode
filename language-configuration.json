{
  "comments": {
    "lineComment": { "comment": "//", "noIndent": false },
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*\\{\\s*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*\\{[^}\"']*$",
      "afterText": "^\\s*\\}",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "^\\s*\\{[^}\"']*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(//.*)?$",
      "afterText": "^\\s*\\}",
      "action": { "indent": "outdent" }
    },
    {
      "beforeText": "^\\s*/\\*(?!\\*/).*$",
      "action": { "indent": "indent" }
    }
  ]
}
