{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "cxs",
  "scopeName": "source.cxs",
  "fileTypes": ["cxs"],
  "comment": "同步对象：clux 字节码汇编（src/vm/bcode_asm.c 的解析规则 + src/vm/bcode_asm_defs.c 的 BCODE_ASM_TABLE 助记符表）。改动指令集后跑 npm run check:highlight —— 它会逐个验证 117 个助记符都被着色，并能直接解析编译器源码做交叉核对。",
  "patterns": [
    { "include": "#comments" },
    { "include": "#labels" },
    { "include": "#directives" },
    { "include": "#instructions" },
    { "include": "#strings" },
    { "include": "#label-references" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.semicolon.cxs",
      "comment": "汇编只有行注释：';' 起始到行尾（bcode_asm.c 只跳过 ';' 起始的行）",
      "match": ";.*$"
    },
    "labels": {
      "name": "entity.name.label.cxs",
      "comment": "标签定义 `<name>:`，名字字符集 [A-Za-z0-9_.-]（label_char_ok）",
      "match": "^\\s*([A-Za-z0-9_.-]+):",
      "captures": {
        "1": { "name": "entity.name.label.cxs" }
      }
    },
    "label-references": {
      "name": "variable.other.label.cxs",
      "comment": "`[label]` 引用（与裸数字地址区分）",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.label.begin.cxs" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.label.end.cxs" }
      },
      "patterns": [
        {
          "name": "variable.other.label.cxs",
          "match": "[A-Za-z0-9_.-]+"
        }
      ]
    },
    "directives": {
      "name": "keyword.directive.cxs",
      "comment": "未知 opcode 兜底 `.byte <十进制 u32>`（大小写无关）",
      "match": "(?i)\\.byte\\b"
    },
    "instructions": {
      "name": "keyword.mnemonic.cxs",
      "comment": "BCODE_ASM_TABLE 全表（117 条，大小写无关）。缺一条就会把该指令显示成普通标识符。",
      "match": "(?i)\\b(add|add_embed|addr|and|append_elem|bind_func|bnot|bxor|call|cast|construct|create_const|create_volatile|data|define|define_bound|define_field|define_type|dispose|div|enum_variant|eq|extern_call|extern_load|extern_store|field_get|field_set|free|free_recursive|func_type_param|func_type_return|func_type_vararg|ge|get_member|gt|halt|import|index_get|index_set|is_tag|jmp|jnz|jz|le|length|load|load_attr|load_function|load_type|lt|make|make_enum|make_function|mark_unique|member_call|mod|mul|ne|neg|new|not|opt_is_none|or|pop|pop_scope|ptr_get|ptr_set|push|push_array|push_bool|push_const|push_cunion|push_enum|push_f32|push_f64|push_func_type|push_function|push_i16|push_i32|push_i64|push_i8|push_opt|push_opt_none|push_ptr|push_scope|push_slice|push_string|push_struct|push_tuple|push_u16|push_u32|push_u64|push_u8|push_undefined|push_usize|push_union|push_value|push_volatile|ret|seal|set_closure|set_field_ownership|set_func_captures|set_func_name|set_ownership|set_type|set_type_name|shl|shr|slice|store|store_attr|store_nil|store_reinit|sub|take_slot|union_member|unwrap)\\b"
    },
    "strings": {
      "name": "string.quoted.double.cxs",
      "comment": "字符串操作数（符号名 / 类型名 / 字面量）：转义白名单 \\n \\t \\r \\\" \\\\ \\xHH（恰好两位）",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.cxs" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.cxs" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.cxs",
          "match": "\\\\(?:[ntr\\\\\"]|x[0-9a-fA-F]{2})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cxs",
          "comment": "f32/f64 操作数（strtod；不含进制前缀）",
          "match": "(?<![\\w.])\\-?(?:\\d+\\.\\d+(?:[eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+)(?![\\w.])"
        },
        {
          "name": "constant.numeric.decimal.cxs",
          "comment": "整型操作数：十进制，可为负（strtoull/strtoll 只认 10 进制；.byte 亦然）",
          "match": "(?<![\\w.])\\-?\\d+(?![\\w.])"
        }
      ]
    }
  }
}
