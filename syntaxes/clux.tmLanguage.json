{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "clux",
  "scopeName": "source.clux",
  "fileTypes": ["cx"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#comptime-keyword" },
    { "include": "#struct-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#union-declaration" },
    { "include": "#function-declaration" },
    { "include": "#function-type-keyword" },
    { "include": "#var-declaration" },
    { "include": "#type-keywords" },
    { "include": "#control-keywords" },
    { "include": "#modifier-keywords" },
    { "include": "#literal-keywords" },
    { "include": "#cast-keyword" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.clux",
          "match": "//.*$"
        },
        {
          "name": "comment.block.clux",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.clux" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.clux" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.clux",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.clux" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.clux" }
      },
      "patterns": [
        { "include": "#escape-sequence" }
      ]
    },
    "characters": {
      "name": "string.quoted.single.clux",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.clux" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.clux" }
      },
      "patterns": [
        { "include": "#escape-sequence" }
      ]
    },
    "escape-sequence": {
      "name": "constant.character.escape.clux",
      "match": "\\\\(n|t|r|\\\\|'|\"|0|x[0-9a-fA-F]{1,2})"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.clux",
          "match": "\\b(0[xX][0-9a-fA-F]+)([iu](8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.clux",
          "match": "\\b(0[oO][0-7]+)([iu](8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.clux",
          "match": "\\b(0[bB][01]+)([iu](8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.clux",
          "match": "\\b((\\d+\\.\\d*|\\.\\d+)([eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+)(f(32|64))?\\b"
        },
        {
          "name": "constant.numeric.clux",
          "match": "\\b(\\d+)([iu](8|16|32|64))?\\b"
        }
      ]
    },
    "comptime-keyword": {
      "match": "\\bcomptime\\b",
      "name": "storage.modifier.clux"
    },
    "struct-declaration": {
      "match": "\\b(struct)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.clux" },
        "2": { "name": "entity.name.type.clux" }
      }
    },
    "enum-declaration": {
      "match": "\\b(enum)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.clux" },
        "2": { "name": "entity.name.type.clux" }
      }
    },
    "union-declaration": {
      "match": "\\b(union)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.clux" },
        "2": { "name": "entity.name.type.clux" }
      }
    },
    "function-declaration": {
      "match": "\\b(func)\\s*(?:\\|[^|\\n]*\\|\\s*)?([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.clux" },
        "2": { "name": "entity.name.function.clux" }
      }
    },
    "function-type-keyword": {
      "match": "\\bfunc(?=\\s*\\()",
      "name": "storage.type.clux"
    },
    "var-declaration": {
      "match": "\\b(var)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.clux" },
        "2": { "name": "variable.other.clux" }
      }
    },
    "type-keywords": {
      "patterns": [
        {
          "match": "\\b(bool|f32|f64|i8|i16|i32|i64|str|u8|u16|u32|u64|void)\\b",
          "name": "storage.type.primitive.clux"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|switch|while|for|break|continue|return)\\b",
          "name": "keyword.control.clux"
        },
        {
          "match": "\\b(default)\\b",
          "name": "keyword.control.clux"
        }
      ]
    },
    "modifier-keywords": {
      "patterns": [
        {
          "match": "\\b(const|volatile)\\b",
          "name": "storage.modifier.clux"
        }
      ]
    },
    "literal-keywords": {
      "patterns": [
        {
          "match": "\\b(true|false|undefined|nil)\\b",
          "name": "constant.language.clux"
        }
      ]
    },
    "cast-keyword": {
      "patterns": [
        {
          "match": "\\b(as|extends|is)\\b",
          "name": "keyword.operator.clux"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.clux",
          "match": "<<|>>|<=|>=|==|!=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|::|[+\\-*/%<>=!&|^~?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.clux",
          "match": "[\\[\\](){}]"
        },
        {
          "name": "punctuation.separator.clux",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.clux",
          "match": "\\."
        }
      ]
    }
  }
}
