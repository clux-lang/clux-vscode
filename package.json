{
  "name": "clux",
  "displayName": "clux",
  "description": "clux language support: syntax highlighting (.cx + .cxs) and formatting",
  "version": "0.2.1",
  "publisher": "clux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AserJoker/clux-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "clux",
    "language",
    "syntax"
  ],
  "activationEvents": [
    "onLanguage:clux",
    "onLanguage:cxs",
    "onCommand:clux.setBinaryPath"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "clux",
      "properties": {
        "clux.binaryPath": {
          "type": "string",
          "default": "clux",
          "scope": "window",
          "markdownDescription": "Path to the clux executable used for formatting.\n\nUse an absolute path if `clux` is not on your `PATH`, e.g. `D:/projects/clux/build/clux.exe` on Windows or `/usr/local/bin/clux` on Linux/macOS."
        }
      }
    },
    "commands": [
      {
        "command": "clux.formatDocument",
        "title": "clux: Format Document",
        "category": "clux"
      },
      {
        "command": "clux.setBinaryPath",
        "title": "clux: Set Binary Path",
        "category": "clux"
      }
    ],
    "languages": [
      {
        "id": "clux",
        "aliases": [
          "clux",
          "clux language"
        ],
        "extensions": [
          ".cx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cxs",
        "aliases": [
          "cxs",
          "clux assembly"
        ],
        "extensions": [
          ".cxs"
        ],
        "configuration": "./language-configuration.cxs.json"
      }
    ],
    "grammars": [
      {
        "language": "clux",
        "scopeName": "source.clux",
        "path": "./syntaxes/clux.tmLanguage.json"
      },
      {
        "language": "cxs",
        "scopeName": "source.cxs",
        "path": "./syntaxes/cxs.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check:highlight": "node scripts/highlight-check.js",
    "check:langconfig": "node scripts/validate-language-config.js",
    "package": "vsce package --out clux-0.2.1.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0",
    "vscode-json-languageservice": "^6.0.0-next.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
